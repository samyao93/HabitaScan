{
  "name": "habitascan-outils",
  "private": true,
  "description": "Outils de développement de HabitaScan (vérification du code, mise en forme, tests). Rien ici n'est déployé.",
  "type": "module",
  "scripts": {
    "construire": "cd .. && node outils/construire.mjs",
    "dev": "cd .. && node outils/construire.mjs --dev",
    "lint": "cd .. && eslint -c outils/eslint.config.mjs .",
    "format": "cd .. && prettier --write \"src/**/*.js\" md.js carte.js \"outils/*.mjs\" \"tests/*.mjs\"",
    "format:verifier": "cd .. && prettier --check \"src/**/*.js\" md.js carte.js \"outils/*.mjs\" \"tests/*.mjs\"",
    "test": "cd .. && node --test \"tests/*.test.mjs\"",
    "verifier": "npm run format:verifier && npm run lint && npm run construire && npm test"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "espree": "11.2.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  }
}
